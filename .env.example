# TRIÂNGULO payment configuration template
# Never put real secret values in GitHub.

TRIANGULO_APP_URL=https://trianguloacores.pt

# Keep test mode as the default.
TRIANGULO_PAYMENTS_MODE=test
TRIANGULO_PAYMENTS_LIVE_ENABLED=false

# Stripe credentials — set real values only in Supabase Edge Function Secrets.
STRIPE_TEST_SECRET_KEY=sk_test_REPLACE_IN_SUPABASE
STRIPE_LIVE_SECRET_KEY=sk_live_REPLACE_IN_SUPABASE

STRIPE_WEBHOOK_SECRET_TEST=whsec_REPLACE_IN_SUPABASE
STRIPE_WEBHOOK_SECRET_LIVE=whsec_REPLACE_IN_SUPABASE

# Enable only after Stripe explicitly supports/approves this for the platform.
STRIPE_CONNECT_PAYPAL_ENABLED=false
